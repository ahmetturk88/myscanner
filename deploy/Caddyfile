{
    admin off
}
{$SITE_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 33MB
    }
    reverse_proxy web:8000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up -CF-Connecting-IP
        header_up -CF-Connecting-IPv6
    }
}
