+// RenderedText returns the visible text of the page the last screenshot of rawURL showed,
+// taking a screenshot first when there is none (MyScanner).
+func RenderedText(rawURL string) (string, error) {
+	validatedURL, err := validateURL(rawURL)
+	if err != nil {
+		return "", fmt.Errorf("URL validation failed: %w", err)
+	}
+	textPath := GetScreenshotPath(validatedURL) + ".txt"
+	cached, readErr := os.ReadFile(textPath)
+	if info, err := os.Stat(textPath); err != nil || readErr != nil || info.IsDir() || time.Since(info.ModTime()) >= constants.ScreenshotTTL ||
+		strings.TrimSpace(string(cached)) == "" { // an empty read may have come before the page filled in
+		_ = os.Remove(GetScreenshotPath(validatedURL)) // a cached image without its text: render again
+		if _, err := TakeScreenshot(rawURL); err != nil {
+			return "", err
+		}
+	}
+	data, err := os.ReadFile(textPath)
+	if err != nil {
+		return "", err
+	}
+	return string(data), nil
+}
