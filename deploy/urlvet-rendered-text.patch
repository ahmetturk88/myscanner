+// renderedTextScript returns the page title and text, bounded (MyScanner). It reads open
+// shadow roots and same-origin frames too: innerText skips both, and a short-link block page
+// drawn inside a web component came back empty.
+const renderedTextScript = `(() => { const out = [document.title || '']; const seen = new Set(); const walk = node => { if (!node || seen.has(node) || out.length > 4000) return; seen.add(node); if (node.nodeType === 3) { const v = node.nodeValue.replace(/\s+/g, ' ').trim(); if (v) out.push(v); return; } if (node.nodeType === 1) { const tag = node.tagName; if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'NOSCRIPT' || tag === 'TEMPLATE') return; if (node.shadowRoot) walk(node.shadowRoot); if (tag === 'IFRAME') { try { walk(node.contentDocument && node.contentDocument.body); } catch (e) {} } } for (const child of node.childNodes || []) walk(child); }; walk(document.body); return out.join('\n').slice(0, 8000); })()`
