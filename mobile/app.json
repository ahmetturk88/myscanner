{
  "expo": {
    "name": "MyScanner",
    "slug": "myscanner",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myscanner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04070f",
    "android": {
      "package": "com.myscanners.app",
      "adaptiveIcon": {
        "backgroundColor": "#04070f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MyScanner uses the camera only to read QR codes you point it at.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04070f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://myscanners.com",
      "eas": {
        "projectId": "14439a4f-137c-4f3f-ac7a-181bd4ef1db6"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ahmedsayrafi"
  }
}
